{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["DOM", "ES2020"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": ".vitest/typescript",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".",
    "target": "ES2020",
    "tsBuildInfoFile": ".vitest/tsconfig.test.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
