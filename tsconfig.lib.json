{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "downlevelIteration": true,
    "emitDeclarationOnly": true,
    "ignoreDeprecations": "6.0",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist/types",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "./src",
    "sourceMap": true,
    "target": "es5",
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.lib.tsbuildinfo",
    "types": []
  },
  "exclude": ["node_modules", "dist", "test"],
  "include": ["src/**/*.ts"]
}
