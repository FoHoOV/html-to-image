{
  "compilerOptions": {
    "esModuleInterop": true,
    "emitDeclarationOnly": true,
    "lib": ["DOM", "ES2015"],
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "types": []
  }
}
