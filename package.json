{
  "name": "@fohoov/html-to-image",
  "version": "3.0.0",
  "type": "module",
  "description": "Generates an image from a DOM node using HTML5 canvas and SVG.",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "unpkg": "./dist/browser/html-to-image.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "screenshot",
    "capture",
    "canvas",
    "html",
    "dom",
    "image",
    "vector",
    "svg"
  ],
  "scripts": {
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"test/**/*.ts\" \"*.config.{js,ts}\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "lib:typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "node:typecheck": "tsc -p tsconfig.node.json --noEmit",
    "clean": "rimraf dist",
    "build:types": "tsc -b tsconfig.lib.json --force",
    "build:code": "rollup -c",
    "build": "pnpm run build:types && pnpm run build:code",
    "analyze": "rollup -c --environment ANALYZE:true",
    "prebuild": "pnpm run lint && pnpm run clean",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "release": "pnpm build && changeset publish",
    "test": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:watch": "vitest --coverage",
    "test:debug": "vitest --project=chromium --browser.headless=false --browser.ui",
    "pretest": "rimraf ./.vitest && pnpm lib:typecheck && pnpm node:typecheck && pnpm test:typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{js,jsx,less,md,json}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "chrome >= 64",
    "edge >= 79",
    "firefox >= 68",
    "safari >= 12",
    "ios_saf >= 12"
  ],
  "license": "MIT",
  "author": {
    "name": "bubkooo",
    "email": "bubkoo.wy@gmail.com"
  },
  "contributors": [
    {
      "name": "FoHoOV",
      "email": "fohoov@gmail.com",
      "url": "https://github.com/FoHoOV"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoHoOV/html-to-image.git"
  },
  "bugs": {
    "url": "https://github.com/FoHoOV/html-to-image/issues"
  },
  "homepage": "https://github.com/FoHoOV/html-to-image#readme",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^6.1.2",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-swc": "^0.4.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "^0.5.23",
    "@types/node": "24.13.3",
    "@types/pixelmatch": "^5.2.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "pixelmatch": "^5.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^4.1.2",
    "rollup": "^4.62.3",
    "rollup-plugin-output-size": "^2.0.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
