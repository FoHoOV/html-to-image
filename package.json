{
  "name": "@fohoov/html-to-image",
  "version": "2.0.1",
  "type": "module",
  "description": "Generates an image from a DOM node using HTML5 canvas and SVG.",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "screenshot",
    "capture",
    "canvas",
    "html",
    "dom",
    "image",
    "vector",
    "svg"
  ],
  "scripts": {
    "lint": "eslint 'src/**/*.{js,ts}?(x)'",
    "lint:fix": "pnpm lint --fix",
    "clean": "rimraf dist es lib",
    "build:code": "rollup -c --bundleConfigAsCjs",
    "build:types": "tsc -p tsconfig.lib.json",
    "build": "pnpm run build:types && pnpm run build:code",
    "prebuild": "pnpm run lint && pnpm run clean",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test": "vitest run --coverage",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:watch": "vitest --coverage",
    "test:debug": "vitest --project=chromium --browser.headless=false --browser.ui",
    "coveralls": "cat ./test/coverage/lcov.info | coveralls",
    "pretest": "rimraf ./test/coverage ./.vitest && pnpm test:typecheck",
    "prepare": "is-ci || husky install .husky"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{js,jsx,less,md,json}": [
      "prettier --write"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "bubkooo",
    "email": "bubkoo.wy@gmail.com"
  },
  "contributors": [
    {
      "name": "FoHoOV",
      "email": "fohoov@gmail.com",
      "url": "https://github.com/FoHoOV"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoHoOV/html-to-image.git"
  },
  "bugs": {
    "url": "https://github.com/FoHoOV/html-to-image/issues"
  },
  "homepage": "https://github.com/FoHoOV/html-to-image#readme",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@fortawesome/fontawesome-free": "^6.1.2",
    "@rollup/plugin-commonjs": "^24.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "24.13.3",
    "@types/pixelmatch": "^5.2.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-istanbul": "^4.1.10",
    "coveralls": "^3.1.1",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.10.2",
    "husky": "^8.0.1",
    "is-ci": "^3.0.1",
    "lint-staged": "^15.2.10",
    "pixelmatch": "^5.3.0",
    "prettier": "^2.8.1",
    "rimraf": "^4.1.2",
    "rollup": "^3.7.4",
    "rollup-plugin-filesize": "^10.0.0",
    "tslib": "^2.4.0",
    "typescript": "^4.9.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
